# Variables de entorno públicas para la aplicación React (Vite / Vercel)

# URL y Anon Key de Supabase (Públicas y seguras en frontend)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Webhook de n8n para el Chat del Asistente IA Interno
VITE_N8N_CHAT_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/chat-asistente

# NOTA DE SEGURIDAD:
# No coloques jamás claves privadas ni la service_role key en este archivo ni en el frontend.
# Las claves privadas solo deben configurarse en el panel de Supabase Dashboard y en n8n.
